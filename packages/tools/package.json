{
	"name": "@quantamental/tools",
	"version": "0.3.0",
	"description": "AI agent tools for quantamental analysis — wrap indicators, factors, and strategies as typed LLM-callable tools",
	"type": "module",
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22",
		"bun": ">=1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gorango/qtm"
	},
	"exports": {
		".": "./src/index.ts",
		"./adapters": "./src/adapters/index.ts",
		"./registry": "./src/registry/index.ts"
	},
	"scripts": {
		"generate:ts": "bun scripts/generate.ts",
		"generate": "cargo run -p codegen 2>&1 && bun scripts/generate.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@quantamental/core": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.109.0",
		"@langchain/core": "^1.2.1",
		"@types/node": "^25.9.4",
		"@vitest/coverage-v8": "^4.1.9",
		"ai": "^7.0.0",
		"openai": "^6.45.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"@anthropic-ai/sdk": ">=0.30.0",
		"@langchain/core": ">=0.3.0",
		"@quantamental/core": ">=0.1.0",
		"ai": ">=7.0.0",
		"openai": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": {
			"optional": true
		},
		"@langchain/core": {
			"optional": true
		},
		"@quantamental/core": {
			"optional": true
		},
		"ai": {
			"optional": true
		},
		"openai": {
			"optional": true
		}
	}
}
