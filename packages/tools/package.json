{
	"name": "@quantamental/tools",
	"version": "0.1.0",
	"description": "AI agent tools for quantamental analysis — wrap indicators, factors, and strategies as typed LLM-callable tools",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./adapters": "./src/adapters/index.ts",
		"./registry": "./src/registry/index.ts"
	},
	"scripts": {
		"generate:ts": "bun scripts/generate.ts",
		"generate": "cargo run -p codegen 2>&1 && bun scripts/generate.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@quantamental/bindings": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.101.0",
		"@langchain/core": "^1.1.48",
		"@types/node": "^25.9.2",
		"@vitest/coverage-v8": "^4.1.8",
		"ai": "^6.0.197",
		"openai": "^6.42.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"@anthropic-ai/sdk": ">=0.30.0",
		"@langchain/core": ">=0.3.0",
		"@quantamental/bindings": ">=0.1.0",
		"ai": ">=4.0.0",
		"openai": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": {
			"optional": true
		},
		"@langchain/core": {
			"optional": true
		},
		"@quantamental/bindings": {
			"optional": true
		},
		"ai": {
			"optional": true
		},
		"openai": {
			"optional": true
		}
	}
}
