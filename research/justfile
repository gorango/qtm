# Standalone traditional-strategy research (research/ta):
# the quantamental catalog screened over Binance OHLCV with zero infra.
# Run recipes from this directory:  just -C research <recipe>
#
# Everything runs through uv: `uv run` creates/uses ta/.venv, installs the
# third-party deps from ta/pyproject.toml and builds the quantamental wheel
# from ../../bindings/py on first use.

set shell := ["bash", "-cu"]

default: setup

# Create/sync the Python env (third-party deps + the quantamental wheel).
setup:
    cd ta && uv sync

# (Re)generate config/symbols.yaml — the hydration universe (CoinGecko × Binance Futures).
symbols:
    cd ta && uv run python config/symbols-sync.py

# Full OHLCV hydration: vision monthly backfill + REST tail.
data-sync:
    cd ta && uv run python binance_loader.py --sync

# Daily incremental tail refresh (REST only).
data-update:
    cd ta && uv run python binance_loader.py --update

# Screen the strategy catalog (IC over the universe).
screen:
    cd ta && uv run python screen.py --all
