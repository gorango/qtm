{
	"name": "@quantamental/strategies",
	"version": "0.1.0",
	"description": "Native Rust trading strategies",
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform",
		"test": "cargo test",
		"lint": "cargo clippy"
	},
	"dependencies": {
		"@napi-rs/cli": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"typescript": "^5.9.3",
		"@biomejs/biome": "^1.9.0",
		"bun-types": "latest"
	},
	"napi": {
		"binaryName": "strategies",
		"target": {
			"defaults": true,
			"additional": [
				"aarch64-unknown-linux-gnu"
			]
		}
	}
}
